<%-- Encabezado común: antes de incluirlo, cada vista define ${titulo} y ${seccion} con c:set --%>
<%@page pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="jakarta.tags.core"%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>${titulo} · Sistema Académico</title>
        <script>
            // Aplica el tema guardado antes de pintar, para que no parpadee
            try { var t = localStorage.getItem("tema"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="${ctx}/css/estilos.css">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><rect width='24' height='24' rx='6' fill='%234f46e5'/><path d='M4 10l8-4 8 4-8 4z' fill='white'/><path d='M7.5 12v3.5c2.5 2 6.5 2 9 0V12' stroke='white' stroke-width='1.6' fill='none'/></svg>">
    </head>
    <body>
        <%-- Sprite de iconos: se usan con <svg class="ico"><use href="#i-nombre"/></svg> --%>
        <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
            <defs>
                <symbol id="i-gorro" viewBox="0 0 24 24"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/><path d="M22 10v6"/></symbol>
                <symbol id="i-inicio" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></symbol>
                <symbol id="i-alumnos" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
                <symbol id="i-alta" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></symbol>
                <symbol id="i-libro" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></symbol>
                <symbol id="i-grafico" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 15v2M11 11v6M15 7v10M19 12v5"/></symbol>
                <symbol id="i-edificio" viewBox="0 0 24 24"><path d="M3 21h18M5 21V10M19 21V10M9 21v-6h6v6"/><path d="m2 10 10-6 10 6"/></symbol>
                <symbol id="i-docente" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4M7 9l3 2 4-4 3 3"/></symbol>
                <symbol id="i-calendario" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
                <symbol id="i-flecha" viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></symbol>
                <symbol id="i-volver" viewBox="0 0 24 24"><path d="M19 12H5M11 19l-7-7 7-7"/></symbol>
                <symbol id="i-buscar" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></symbol>
                <symbol id="i-editar" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></symbol>
                <symbol id="i-borrar" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></symbol>
                <symbol id="i-mas" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
                <symbol id="i-ok" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></symbol>
                <symbol id="i-alerta" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></symbol>
                <symbol id="i-cerrar" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
                <symbol id="i-vacio" viewBox="0 0 24 24"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></symbol>
                <symbol id="i-sol" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
                <symbol id="i-luna" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></symbol>
                <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
            </defs>
        </svg>

        <header class="navbar">
            <div class="contenedor">
                <a class="marca" href="${ctx}/Inicio">
                    <span class="logo"><svg class="ico"><use href="#i-gorro"/></svg></span>
                    <span>Sistema <b>Académico</b></span>
                </a>
                <button class="btn-icono nav-toggle" type="button" aria-label="Abrir menú"
                        onclick="document.body.classList.toggle('menu-abierto')">
                    <svg class="ico"><use href="#i-menu"/></svg>
                </button>
                <nav class="nav-links">
                    <a href="${ctx}/Inicio" class="${seccion == 'inicio' ? 'activo' : ''}"><svg class="ico"><use href="#i-inicio"/></svg>Inicio</a>
                    <a href="${ctx}/Alumnos" class="${seccion == 'alumnos' ? 'activo' : ''}"><svg class="ico"><use href="#i-alumnos"/></svg>Alumnos</a>
                    <a href="${ctx}/Docentes" class="${seccion == 'docentes' ? 'activo' : ''}"><svg class="ico"><use href="#i-docente"/></svg>Docentes</a>
                    <a href="${ctx}/MateriaManejador" class="${seccion == 'materias' ? 'activo' : ''}"><svg class="ico"><use href="#i-libro"/></svg>Materias</a>
                    <a href="${ctx}/Listar" class="${seccion == 'consultas' ? 'activo' : ''}"><svg class="ico"><use href="#i-grafico"/></svg>Consultas</a>
                </nav>
                <button class="btn-icono" type="button" id="tema" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema">
                    <svg class="ico solo-claro"><use href="#i-luna"/></svg>
                    <svg class="ico solo-oscuro"><use href="#i-sol"/></svg>
                </button>
            </div>
        </header>
        <main class="contenedor">
